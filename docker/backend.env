# Local Docker stack only. Every secret here is a throwaway dev value.
# Override (e.g. real Stripe *test* keys) in docker/backend.local.env, which is gitignored.
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

MONGODB_URI=mongodb://mongo:27017/gema?replicaSet=rs0
REDIS_HOST=redis
REDIS_PORT=6379

JWT_SECRET=local-docker-jwt-secret-not-for-production-0001
JWT_REFRESH_SECRET=local-docker-refresh-secret-not-for-production-02
SESSION_SECRET=local-docker-session-secret

# Mailpit: every email lands in http://localhost:8025
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USERNAME=dev
EMAIL_PASSWORD=dev
EMAIL_FROM=no-reply@kidrove.local
EMAIL_FROM_NAME=Kidrove Local

# Dummy keys let the server boot; payments need real sk_test_/pk_test_ keys in backend.local.env
STRIPE_SECRET_KEY=sk_test_dummydummydummydummy
STRIPE_TEST_SECRET_KEY=sk_test_dummydummydummydummy
STRIPE_PUBLISHABLE_KEY=pk_test_dummydummydummydummy
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_dummydummydummydummy
STRIPE_WEBHOOK_SECRET=whsec_dummydummydummy
PAYMENT_ENVIRONMENT=test
USE_LIVE_KEYS=false

# Never send real SMS/WhatsApp from a local stack
COMMUNICATION_TEST_MODE=true

# Skip ts-node type-checking (tsc does that); startup drops from minutes to seconds
TS_NODE_TRANSPILE_ONLY=true
